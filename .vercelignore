# Keep only the pure search vocabulary imported by the web catalog.
# Excluding the entire desktop directory also removes this build dependency.
apps/desktop/*
!apps/desktop/src/
apps/desktop/src/*
!apps/desktop/src/lib/
apps/desktop/src/lib/*
!apps/desktop/src/lib/catalogLanguageSearch.ts
!apps/desktop/src/lib/catalogSearchQuery.ts

# Dependencies and generated output are rebuilt by Vercel.
node_modules/
apps/web/dist/
server/dist/
dist/
.pnpm-store/
*.tsbuildinfo

# Local databases, installers, logs, screenshots and test artefacts.
*.db
*.db-*
*.sqlite
*.sqlite3
*.exe
*.blockmap
*.zip
logs/
tmp/
local-scripts/
shift-backups/
Вивантаження/
BELT_RECONCILIATION_*.md
FILTER_CROSS_PROGRESS_*.md
docs/SALES_MIRROR_REPAIR_*.md
mirror-identity.json
Mirror-registration-*.json
Mirror-state-repair-*.json
Sales-mirror-repair-*.json
qa/
.ux-shots/
test_*.cjs
test_*.js
server/test_*.cjs
server/test_*.js

# Local configuration and credentials, including operator API credentials.
.env*
*.local
*service-account*
*key.json
.vercel/

# Private operational reports are not website assets.
docs/ELF_STOCK_REVIEW_*.md
docs/AI_DUPLICATES_REVIEW_*.md
docs/AI_DUPLICATES_FIX_*.md
