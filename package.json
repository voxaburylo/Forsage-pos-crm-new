{
  "name": "crm-forsage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter=web --filter=server dev",
    "dev:web": "pnpm --filter=web dev",
    "dev:server": "pnpm --filter=server dev",
    "build": "pnpm --filter=web build && pnpm --filter=server build",
    "build:web": "pnpm --filter=web build",
    "build:server": "pnpm --filter=server build",
    "build:desktop": "pnpm --filter=desktop dist",
    "desktop:smoke": "pnpm --filter=desktop smoke:db",
    "desktop:dist": "pnpm --filter=desktop dist",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --filter=web typecheck && pnpm --filter=desktop typecheck && pnpm --filter=server typecheck",
    "test": "pnpm --filter=web test && pnpm --filter=desktop test && pnpm --filter=server test",
    "verify": "pnpm typecheck && pnpm --filter=web lint && pnpm test"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js": "1.14.4",
      "body-parser": "1.20.6",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=5.0.0 <6.0.0": "5.0.7",
      "fast-uri": "3.1.3",
      "form-data": "4.0.6",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "qs": "6.15.2",
      "vite": "6.4.3"
    }
  },
  "dependencies": {
    "axios": "^1.19.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
